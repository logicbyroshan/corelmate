<UserControl x:Class="CorelMate.UI.CorelMatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CorelMateAppBackgroundBrush}"
             Foreground="{DynamicResource CorelMateTextPrimaryBrush}"
             FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
             FontSize="12"
             SnapsToDevicePixels="True"
             MinWidth="280"
             MinHeight="500">
  <UserControl.Resources>
    <ResourceDictionary Source="/CorelMate.UI;component/Themes/CorelMateTheme.xaml" />
  </UserControl.Resources>

  <Grid Margin="10,8,10,10">
    <Grid.RowDefinitions>
      <!-- Row 0: App Header & Connection Pill -->
      <RowDefinition Height="Auto" />
      <!-- Row 1: Streamlined Navigation Tabs (3 tabs) -->
      <RowDefinition Height="Auto" />
      <!-- Row 2: Active Tab Content -->
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== HEADER ==================== -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Logo -->
      <Image Grid.Column="0" Width="26" Height="26" Stretch="Uniform" Source="/CorelMate.UI;component/Assets/corelmate-logo.png" Margin="0,0,8,0" VerticalAlignment="Center" />

      <!-- Title & Version Tag -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="CORELMATE" Style="{StaticResource CorelMateHeaderTitleStyle}" VerticalAlignment="Center" />
          <Border Background="{DynamicResource CorelMatePillBgBrush}" BorderBrush="{DynamicResource CorelMatePillBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMatePillCornerRadius}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderEraText" Text="v27" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateAccentBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Text="Productivity Suite for CorelDRAW" Style="{StaticResource CorelMateCaptionStyle}" FontSize="10" />
      </StackPanel>

      <!-- Theme Switcher Button (☀️ / 🌙) -->
      <Button x:Name="ThemeToggleButton" Grid.Column="2" Content="☀️" ToolTip="Toggle Light / Dark Theme" Click="ThemeToggle_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" MinHeight="26" MinWidth="28" Padding="4,2" VerticalAlignment="Center" />

      <!-- Live Connection Status Pill -->
      <Border Grid.Column="4" Background="{DynamicResource CorelMateSurfaceRaisedBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMatePillCornerRadius}" Padding="8,3" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ConnectionBadge_Click" ToolTip="Click to test/reconnect CorelDRAW">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusIndicatorDot" Width="7" Height="7" Fill="{DynamicResource CorelMateSuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusBadgeText" Text="Connected" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource CorelMateTextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ==================== STREAMLINED NAVIGATION TABS (3 TABS) ==================== -->
    <Border Grid.Row="1" Background="{DynamicResource CorelMateSurfaceBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="2" Margin="0,0,0,10">
      <UniformGrid Rows="1">
        <RadioButton x:Name="TabCurvesRadio" Content="🔤 Curves" Style="{StaticResource CorelMateTabButtonStyle}" IsChecked="True" Checked="TabRadio_Checked" />
        <RadioButton x:Name="TabBadgesRadio" Content="🏷️ Badges" Style="{StaticResource CorelMateTabButtonStyle}" Checked="TabRadio_Checked" />
        <RadioButton x:Name="TabInspectorRadio" Content="⚙️ Tools &amp; Info" Style="{StaticResource CorelMateTabButtonStyle}" Checked="TabRadio_Checked" />
      </UniformGrid>
    </Border>

    <!-- ==================== TAB CONTENT AREA ==================== -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <!-- ==================== TAB 1: TEXT TO CURVES (PRIMARY FEATURE) ==================== -->
        <StackPanel x:Name="CurvesTabContent" Visibility="Visible">

          <!-- Active Document Status Banner -->
          <Border Background="{DynamicResource CorelMateSurfaceRaisedBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="10,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="ACTIVE DOCUMENT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" Margin="0,0,0,2" />
                <TextBlock x:Name="DashDocumentText" Text="Scanning CorelDRAW..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1" Content="🔄" ToolTip="Refresh Active Document Status" Click="RefreshDoc_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" MinHeight="24" Padding="6,2" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Core Feature Card: Convert Text to Curves -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <TextBlock Text="CONVERT TEXT TO CURVES" Style="{StaticResource CorelMateSectionTitleStyle}" />
              <TextBlock Text="Converts fonts to vector curves in-place. Preserves colors, stacking order, PowerClips, and formatting." Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,10" />

              <!-- Target Scope Selector -->
              <TextBlock Text="CONVERSION SCOPE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextSecondaryBrush}" Margin="0,0,0,6" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ScopeCurrentPageRadio" Grid.Column="0" Content="Current Page" IsChecked="True" GroupName="CurvesScope" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                <RadioButton x:Name="ScopeSelectionRadio" Grid.Column="2" Content="Selection" GroupName="CurvesScope" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                <RadioButton x:Name="ScopeAllPagesRadio" Grid.Column="4" Content="All Pages" GroupName="CurvesScope" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
              </Grid>

              <!-- Conversion Options -->
              <Border Background="{DynamicResource CorelMateSurfaceSubtleBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                  <CheckBox x:Name="CurvesSaveCopyCheck" Content="Save backup copy before converting (_curves.cdr)" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <CheckBox x:Name="CurvesUnlockShapesCheck" Content="Unlock locked text objects automatically" IsChecked="True" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" FontSize="11" />
                </StackPanel>
              </Border>

              <!-- Primary Action Button: 1-Click Convert -->
              <Button x:Name="ConvertCurvesButton" Content="⚡ Convert Text to Curves" Click="ConvertCurvesButton_Click" Style="{StaticResource CorelMatePrimaryButtonStyle}" MinHeight="38" FontSize="13" Margin="0,0,0,8" />

              <!-- Secondary Action Button: Preflight Only -->
              <Button x:Name="PreflightCurvesButton" Content="🔍 Preflight &amp; Analyze" Click="PreflightCurvesButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" Margin="0,0,0,8" />

              <!-- Live Preflight Metric Breakdown -->
              <Grid x:Name="CurvesMetricsGrid" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FOUND" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurvesFoundCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CONVERT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurvesConvertibleCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateAccentBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GROUPS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurvesGroupsCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="LOCKED" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurvesLockedCountText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateWarningBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock x:Name="CurvesPreflightDetailText" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,8" Visibility="Collapsed" />

              <!-- Results Card -->
              <Border x:Name="CurvesResultCard" Background="{DynamicResource CorelMateSurfaceSubtleBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="10,8">
                <TextBlock x:Name="CurvesResultText" Text="Select scope above and click Convert Text to Curves." Style="{StaticResource CorelMateBodyStyle}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ==================== TAB 2: BADGE GENERATOR ==================== -->
        <StackPanel x:Name="BadgesTabContent" Visibility="Collapsed">
          <!-- Status Banner -->
          <Border x:Name="StatusBanner" Background="{DynamicResource CorelMateSurfaceRaisedBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="10,8" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="Select a master badge template in CorelDRAW to begin." Style="{StaticResource CorelMateBodyStyle}" Foreground="{DynamicResource CorelMateTextSecondaryBrush}" />
          </Border>

          <!-- 1. Master Artwork Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MASTER ARTWORK" Style="{StaticResource CorelMateSectionTitleStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="DimensionsText" Grid.Column="1" Text="No artwork captured" Style="{StaticResource CorelMateCaptionStyle}" VerticalAlignment="Center" />
              </Grid>

              <Button x:Name="UseSelectedButton" Content="⚡ Use Selected Artwork" Click="UseSelectedButton_Click" Style="{StaticResource CorelMatePrimaryButtonStyle}" Margin="0,0,0,8" />

              <TextBlock Text="DETECTED VARIABLES" Style="{StaticResource CorelMateCaptionStyle}" FontWeight="SemiBold" Margin="0,4,0,4" />
              <WrapPanel x:Name="VariablesWrapPanel">
                <Border Style="{StaticResource CorelMatePillStyle}">
                  <TextBlock x:Name="VariablesText" Text="None detected" FontSize="11" Foreground="{DynamicResource CorelMateTextMutedBrush}" />
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- 2. Data Rows Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DATA ENTRIES" Style="{StaticResource CorelMateSectionTitleStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="RowCountText" Grid.Column="1" Text="0 rows" Style="{StaticResource CorelMateCaptionStyle}" VerticalAlignment="Center" />
              </Grid>

              <WrapPanel Margin="0,0,0,8">
                <Button x:Name="AddRowButton" Content="+ Add Row" Click="AddRowButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" IsEnabled="False" Margin="0,0,6,4" />
                <Button x:Name="DeleteRowButton" Content="✕ Delete Last" Click="DeleteRowButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" IsEnabled="False" Margin="0,0,6,4" />
                <Button x:Name="ImportDataButton" Content="📥 Import CSV" Click="ImportDataButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" IsEnabled="False" Margin="0,0,0,4" />
              </WrapPanel>

              <Border Background="{DynamicResource CorelMateSurfaceSubtleBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="6" MinHeight="60" MaxHeight="180">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="RowsPanel">
                    <TextBlock x:Name="EmptyRowsHint" Text="Capture master artwork to configure data rows or import CSV." Style="{StaticResource CorelMateCaptionStyle}" HorizontalAlignment="Center" Margin="0,16" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- 3. Layout & Spacing Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <TextBlock Text="LAYOUT &amp; SPACING (MM)" Style="{StaticResource CorelMateSectionTitleStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                  <TextBlock Text="Width (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="BadgeWidthText" Style="{StaticResource CorelMateTextBoxStyle}" TextChanged="LayoutTextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                  <TextBlock Text="Height (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="BadgeHeightText" Style="{StaticResource CorelMateTextBoxStyle}" TextChanged="LayoutTextChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                  <TextBlock Text="Horizontal Gap (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="HorizontalGapText" Style="{StaticResource CorelMateTextBoxStyle}" Text="3" TextChanged="LayoutTextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                  <TextBlock Text="Vertical Gap (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="VerticalGapText" Style="{StaticResource CorelMateTextBoxStyle}" Text="3" TextChanged="LayoutTextChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="Horiz Margin (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="HorizontalMarginText" Style="{StaticResource CorelMateTextBoxStyle}" Text="5" TextChanged="LayoutTextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="Vert Margin (mm)" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,2" />
                  <TextBox x:Name="VerticalMarginText" Style="{StaticResource CorelMateTextBoxStyle}" Text="5" TextChanged="LayoutTextChanged" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 4. Generation Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <TextBlock Text="PLAN &amp; GENERATION" Style="{StaticResource CorelMateSectionTitleStyle}" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MetricTotalText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateAccentBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="COLS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MetricColumnsText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PER PAGE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MetricPerPageText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PAGES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MetricPagesText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock x:Name="PreviewDetailText" Text="Capture a master to preview the layout plan." Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,8" />

              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="GenerateButton" Grid.Column="0" Content="🚀 Generate Badges" Click="GenerateButton_Click" Style="{StaticResource CorelMatePrimaryButtonStyle}" IsEnabled="False" />
                <Button x:Name="PreviewButton" Grid.Column="2" Content="🔄 Preview" Click="PreviewButton_Click" Style="{StaticResource CorelMateButtonStyle}" IsEnabled="False" />
                <Button x:Name="ResetButton" Grid.Column="4" Content="Reset" Click="ResetButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" />
              </Grid>
              <TextBlock x:Name="ResultText" Style="{StaticResource CorelMateBodyStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ==================== TAB 3: TOOLS, INSPECTOR & SETTINGS ==================== -->
        <StackPanel x:Name="InspectorTabContent" Visibility="Collapsed">
          <!-- Document Inspector Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DOCUMENT INSPECTOR" Style="{StaticResource CorelMateSectionTitleStyle}" VerticalAlignment="Center" />
                <Button x:Name="RefreshInspectorButton" Grid.Column="1" Content="🔄 Inspect Active Doc" Click="RefreshInspectorButton_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" />
              </Grid>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel>
                    <TextBlock Text="DOCUMENT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" />
                    <TextBlock x:Name="InspDocNameText" Text="No document" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel>
                    <TextBlock Text="DETAILS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" />
                    <TextBlock x:Name="InspDimensionsText" Text="-" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateAccentBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Shapes Counts Breakdown -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SHAPES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="InspTotalShapesText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TEXT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="InspTextShapesText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateAccentBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CURVES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="InspCurvesShapesText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateInfoBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CorelMateMetricCardStyle}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="BITMAPS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource CorelMateTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="InspBitmapsShapesText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CorelMateWarningBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Fonts List -->
              <Border Background="{DynamicResource CorelMateSurfaceSubtleBrush}" BorderBrush="{DynamicResource CorelMateCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CorelMateButtonCornerRadius}" Padding="8,6" MinHeight="40" MaxHeight="90">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="InspFontsListText" Text="Click 'Inspect Active Doc' to analyze fonts." Style="{StaticResource CorelMateCaptionStyle}" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- Theme & Appearance Settings -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <TextBlock Text="THEME &amp; APPEARANCE" Style="{StaticResource CorelMateSectionTitleStyle}" />
              <TextBlock Text="Choose a theme or adapt automatically to CorelDRAW's workspace." Style="{StaticResource CorelMateCaptionStyle}" Margin="0,0,0,8" />
              <WrapPanel>
                <Button Content="☀️ Light Theme" Click="ThemeLight_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" Margin="0,0,6,4" />
                <Button Content="🌙 Dark Theme" Click="ThemeDark_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" Margin="0,0,6,4" />
                <Button Content="🖥️ Auto System" Click="ThemeAuto_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" Margin="0,0,0,4" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Host Connection Diagnostics Card -->
          <Border Style="{StaticResource CorelMateCardStyle}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CORELMATE SUITE INFO" Style="{StaticResource CorelMateSectionTitleStyle}" VerticalAlignment="Center" />
                <Button Content="🔄 Reconnect" Click="Reconnect_Click" Style="{StaticResource CorelMateSecondaryButtonStyle}" Grid.Column="1" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Host Version:" FontWeight="SemiBold" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,2,8,2" />
                <TextBlock x:Name="HostVersionText" Grid.Column="1" Text="CorelDRAW 2026" Style="{StaticResource CorelMateCaptionStyle}" Foreground="{DynamicResource CorelMateTextPrimaryBrush}" Margin="0,2,0,2" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Architecture:" FontWeight="SemiBold" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,2,8,2" />
                <TextBlock x:Name="DashArchText" Grid.Column="1" Text="64-bit (x64)" Style="{StaticResource CorelMateCaptionStyle}" Foreground="{DynamicResource CorelMateAccentBrush}" Margin="0,2,0,2" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Connection:" FontWeight="SemiBold" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,2,8,2" />
                <TextBlock x:Name="CompatStatusText" Grid.Column="1" Text="Evaluating..." Style="{StaticResource CorelMateCaptionStyle}" Foreground="{DynamicResource CorelMateSuccessBrush}" Margin="0,2,0,2" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Release Version:" FontWeight="SemiBold" Style="{StaticResource CorelMateCaptionStyle}" Margin="0,2,8,2" />
                <TextBlock Text="v1.18.1 (Production)" Grid.Column="1" Style="{StaticResource CorelMateCaptionStyle}" Foreground="{DynamicResource CorelMateTextSecondaryBrush}" Margin="0,2,0,2" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
