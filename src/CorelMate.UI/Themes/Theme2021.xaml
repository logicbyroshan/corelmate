<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- CorelDRAW 2020-2021 (v22-v23) Graphite & Teal Theme Profile -->
  <Color x:Key="CorelMateAccentColor">#00A389</Color>
  <Color x:Key="CorelMateAccentHoverColor">#1FC6AA</Color>
  <Color x:Key="CorelMateAccentPressedColor">#007D69</Color>

  <SolidColorBrush x:Key="CorelMateAccentBrush" Color="{StaticResource CorelMateAccentColor}" />
  <SolidColorBrush x:Key="CorelMateAccentHoverBrush" Color="{StaticResource CorelMateAccentHoverColor}" />
  <SolidColorBrush x:Key="CorelMateAccentPressedBrush" Color="{StaticResource CorelMateAccentPressedColor}" />

  <LinearGradientBrush x:Key="CorelMatePrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#00A389" Offset="0.0" />
    <GradientStop Color="#007D69" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CorelMatePrimaryGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1FC6AA" Offset="0.0" />
    <GradientStop Color="#00A389" Offset="1.0" />
  </LinearGradientBrush>

  <!-- Surface & Border Tokens -->
  <SolidColorBrush x:Key="CorelMateAppBackgroundBrush" Color="#202124" />
  <SolidColorBrush x:Key="CorelMateSurfaceBrush" Color="#282A2D" />
  <SolidColorBrush x:Key="CorelMateSurfaceRaisedBrush" Color="#323639" />
  <SolidColorBrush x:Key="CorelMateSurfaceSubtleBrush" Color="#242629" />
  <SolidColorBrush x:Key="CorelMateCardBorderBrush" Color="#3C4043" />
  <SolidColorBrush x:Key="CorelMateBorderBrush" Color="#4A4E52" />
  <SolidColorBrush x:Key="CorelMateFocusBorderBrush" Color="#00A389" />

  <!-- Typography Tokens -->
  <SolidColorBrush x:Key="CorelMateTextPrimaryBrush" Color="#E8EAED" />
  <SolidColorBrush x:Key="CorelMateTextSecondaryBrush" Color="#9AA0A6" />
  <SolidColorBrush x:Key="CorelMateTextMutedBrush" Color="#75797E" />
  <SolidColorBrush x:Key="CorelMateTextOnAccentBrush" Color="#FFFFFF" />

  <!-- Feedback Colors -->
  <SolidColorBrush x:Key="CorelMateSuccessBrush" Color="#34A853" />
  <SolidColorBrush x:Key="CorelMateSuccessBgBrush" Color="#1E3827" />
  <SolidColorBrush x:Key="CorelMateSuccessBorderBrush" Color="#2C573A" />

  <SolidColorBrush x:Key="CorelMateWarningBrush" Color="#FBBC04" />
  <SolidColorBrush x:Key="CorelMateWarningBgBrush" Color="#3A301A" />
  <SolidColorBrush x:Key="CorelMateWarningBorderBrush" Color="#5A4A24" />

  <SolidColorBrush x:Key="CorelMateErrorBrush" Color="#EA4335" />
  <SolidColorBrush x:Key="CorelMateErrorBgBrush" Color="#3A1F1D" />
  <SolidColorBrush x:Key="CorelMateErrorBorderBrush" Color="#612925" />

  <SolidColorBrush x:Key="CorelMateInfoBrush" Color="#4285F4" />
  <SolidColorBrush x:Key="CorelMateInfoBgBrush" Color="#1C2A40" />
  <SolidColorBrush x:Key="CorelMateInfoBorderBrush" Color="#2B4369" />

  <SolidColorBrush x:Key="CorelMatePillBgBrush" Color="#303236" />
  <SolidColorBrush x:Key="CorelMatePillBorderBrush" Color="#44474B" />

  <!-- Dimensions -->
  <CornerRadius x:Key="CorelMateCardCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CorelMateButtonCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CorelMatePillCornerRadius">6</CornerRadius>
</ResourceDictionary>

