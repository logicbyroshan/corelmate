<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- CorelMate Professional Dark Theme (Matches CorelDRAW Dark Workspace) -->
  <Color x:Key="CorelMateAccentColor">#10B981</Color>
  <Color x:Key="CorelMateAccentHoverColor">#34D399</Color>
  <Color x:Key="CorelMateAccentPressedColor">#059669</Color>

  <SolidColorBrush x:Key="CorelMateAccentBrush" Color="{StaticResource CorelMateAccentColor}" />
  <SolidColorBrush x:Key="CorelMateAccentHoverBrush" Color="{StaticResource CorelMateAccentHoverColor}" />
  <SolidColorBrush x:Key="CorelMateAccentPressedBrush" Color="{StaticResource CorelMateAccentPressedColor}" />

  <LinearGradientBrush x:Key="CorelMatePrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#10B981" Offset="0.0" />
    <GradientStop Color="#059669" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CorelMatePrimaryGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#34D399" Offset="0.0" />
    <GradientStop Color="#10B981" Offset="1.0" />
  </LinearGradientBrush>

  <!-- Surface & Border Tokens (Dark Palette) -->
  <SolidColorBrush x:Key="CorelMateAppBackgroundBrush" Color="#1E1E22" />
  <SolidColorBrush x:Key="CorelMateSurfaceBrush" Color="#26262B" />
  <SolidColorBrush x:Key="CorelMateSurfaceRaisedBrush" Color="#2E2E35" />
  <SolidColorBrush x:Key="CorelMateSurfaceSubtleBrush" Color="#232328" />
  <SolidColorBrush x:Key="CorelMateCardBorderBrush" Color="#383842" />
  <SolidColorBrush x:Key="CorelMateBorderBrush" Color="#42424E" />
  <SolidColorBrush x:Key="CorelMateFocusBorderBrush" Color="#10B981" />

  <!-- Typography Tokens -->
  <SolidColorBrush x:Key="CorelMateTextPrimaryBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="CorelMateTextSecondaryBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="CorelMateTextMutedBrush" Color="#64748B" />
  <SolidColorBrush x:Key="CorelMateTextOnAccentBrush" Color="#FFFFFF" />

  <!-- Feedback Colors -->
  <SolidColorBrush x:Key="CorelMateSuccessBrush" Color="#10B981" />
  <SolidColorBrush x:Key="CorelMateSuccessBgBrush" Color="#132E24" />
  <SolidColorBrush x:Key="CorelMateSuccessBorderBrush" Color="#1B4D3C" />

  <SolidColorBrush x:Key="CorelMateWarningBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="CorelMateWarningBgBrush" Color="#2B2111" />
  <SolidColorBrush x:Key="CorelMateWarningBorderBrush" Color="#584116" />

  <SolidColorBrush x:Key="CorelMateErrorBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="CorelMateErrorBgBrush" Color="#2A1416" />
  <SolidColorBrush x:Key="CorelMateErrorBorderBrush" Color="#541B1F" />

  <SolidColorBrush x:Key="CorelMateInfoBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="CorelMateInfoBgBrush" Color="#13213B" />
  <SolidColorBrush x:Key="CorelMateInfoBorderBrush" Color="#1D3C72" />

  <SolidColorBrush x:Key="CorelMatePillBgBrush" Color="#32323B" />
  <SolidColorBrush x:Key="CorelMatePillBorderBrush" Color="#464654" />

  <!-- Dimensions -->
  <CornerRadius x:Key="CorelMateCardCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CorelMateButtonCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="CorelMatePillCornerRadius">10</CornerRadius>
</ResourceDictionary>
